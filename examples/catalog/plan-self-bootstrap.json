    "status": "VALID",
    "fingerprint": "f93386e3d4c962e471584af1eba4cd12a928206452bcd55046d3af81323abbbb",
    "tolerances": {
      "catalog_bundle_set_state": "valid_multiple",
      "unexpected_browser_errors": 0,
      "horizontal_overflow_px": 0
