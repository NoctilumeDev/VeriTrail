    "steps": [
      {
        "id": "catalog-visible",
        "action": "expect_visible",
        "selector": "[data-testid='run-catalog']"
      },
      {
        "id": "positive-run-visible",
        "action": "expect_text",
        "selector": "[data-testid='catalog-runs']",
        "value": "m2-freeze-pass"
      },
      {
        "id": "open-positive-run",
        "action": "click",
        "selector": "[data-catalog-run-id='cr_db7aa710f3dec3267223c2c7']"
      },
      {
        "id": "positive-run-loaded",
        "action": "expect_text",
        "selector": "[data-testid='run-summary']",
        "value": "本地目录 · m2-freeze-pass"
      },
      {
        "id": "pass-verdict-visible",
        "action": "expect_visible",
        "selector": "[data-testid='status-gate'] [aria-label='验收结论：PASS']"
      },
      {
        "id": "capture-catalog-run",
        "action": "screenshot",
        "name": "catalog-run-pass"
      }
    ]
  },
  "load_model": {
    "virtual_users": 1,
    "in_flight_requests": 1
  },
  "change_scope": {
    "level": "L2_CONTRACT",
    "owner": "VeriTrail Catalog / Local Read-only API / Vue Workbench",
    "expected_blast_radius": "Catalog SQLite 0.1, Local Read-only API 0.1 and Workbench Run Catalog",
    "consumers": [
      "catalog-builder",
      "catalog-server",
      "workbench-catalog-loader",
      "m3-bundle-loader",
      "browser-adapter",
      "self-bootstrap-acceptance"
    ]
  },
  "reproduction_steps": [
    "Build Catalog A from the fixed positive and negative M2 seed Bundles.",
    "Serve Catalog A and the Workbench production build on 127.0.0.1:18767.",
    "Run browser-capture with this sealed plan and a unique Run ID."
  ],
  "cleanup_steps": [
    "Close the Playwright browser and every context.",
    "Stop the read-only Catalog service and verify port 18767 is released.",
    "Verify no Catalog staging directory or SQLite sidecar remains."
  ]
