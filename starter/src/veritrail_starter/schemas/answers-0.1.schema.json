{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NoctilumeDev/VeriTrail/starter/schemas/answers-0.1.schema.json",
  "title": "VeriTrail Starter single-webapp Answers 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "preset",
    "workspace_id",
    "question",
    "subject",
    "application",
    "browser",
    "budgets",
    "timeouts",
    "random_seed"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "preset": { "const": "single-webapp" },
    "workspace_id": { "$ref": "#/$defs/identifier" },
    "question": { "type": "string", "minLength": 1, "maxLength": 512 },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "id", "version", "source_ref", "working_directory", "watch_roots"],
      "properties": {
        "root": { "type": "string", "minLength": 3 },
        "id": { "$ref": "#/$defs/identifier" },
        "version": { "type": "string", "minLength": 1 },
        "source_ref": { "$ref": "#/$defs/relativePath" },
        "working_directory": { "$ref": "#/$defs/relativePath" },
        "watch_roots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relativePath" }
        }
      }
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "arguments", "port", "health_path", "expected_status"],
      "properties": {
        "executable": { "type": "string", "minLength": 1 },
        "arguments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "$ref": "#/$defs/argument" }
        },
        "port": { "type": "integer", "minimum": 1024, "maximum": 65535 },
        "health_path": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^/(?!/)" },
        "expected_status": { "const": 200 }
      }
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_url", "allowed_origin", "headless", "timeout_ms", "viewports", "steps", "screenshot_safety"],
      "properties": {
        "start_url": { "type": "string", "pattern": "^http://127\\.0\\.0\\.1:[0-9]+/" },
        "allowed_origin": { "type": "string", "pattern": "^http://127\\.0\\.0\\.1:[0-9]+$" },
        "headless": { "type": "boolean" },
        "timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 30000 },
        "viewports": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/viewport" }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 49,
          "items": { "$ref": "#/$defs/step" }
        },
        "screenshot_safety": { "const": "UNREDACTED_OPERATOR_ACKNOWLEDGED" }
      }
    },
    "budgets": { "$ref": "#/$defs/budgets" },
    "timeouts": { "$ref": "#/$defs/timeouts" },
    "random_seed": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 519,
      "pattern": "^(?:\\.|[A-Za-z0-9][A-Za-z0-9._-]{0,63}(?:/[A-Za-z0-9][A-Za-z0-9._-]{0,63}){0,7})$"
    },
    "pathSegments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
      }
    },
    "argument": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["literal"],
          "properties": {
            "literal": {
              "type": "string",
              "maxLength": 4096,
              "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["run_work_path"],
          "properties": { "run_work_path": { "$ref": "#/$defs/pathSegments" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["node_port"],
          "properties": { "node_port": { "$ref": "#/$defs/identifier" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["node_origin"],
          "properties": { "node_origin": { "$ref": "#/$defs/identifier" } }
        }
      ]
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "width", "height", "is_mobile"],
      "properties": {
        "name": { "enum": ["desktop", "mobile"] },
        "width": { "type": "integer", "minimum": 240, "maximum": 3840 },
        "height": { "type": "integer", "minimum": 240, "maximum": 2160 },
        "is_mobile": { "type": "boolean" }
      }
    },
    "step": {
      "oneOf": [
        { "$ref": "#/$defs/selectorStepClick" },
        { "$ref": "#/$defs/selectorStepFill" },
        { "$ref": "#/$defs/selectorStepPress" },
        { "$ref": "#/$defs/selectorStepExpectVisible" },
        { "$ref": "#/$defs/selectorStepExpectText" }
      ]
    },
    "selectorStepClick": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action", "selector"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "action": { "const": "click" },
        "selector": { "$ref": "#/$defs/selector" }
      }
    },
    "selectorStepFill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action", "selector", "value"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "action": { "const": "fill" },
        "selector": { "$ref": "#/$defs/selector" },
        "value": { "$ref": "#/$defs/stepValue" }
      }
    },
    "selectorStepPress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action", "selector", "value"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "action": { "const": "press" },
        "selector": { "$ref": "#/$defs/selector" },
        "value": { "$ref": "#/$defs/stepValue" }
      }
    },
    "selectorStepExpectVisible": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action", "selector"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "action": { "const": "expect_visible" },
        "selector": { "$ref": "#/$defs/selector" }
      }
    },
    "selectorStepExpectText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action", "selector", "value"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "action": { "const": "expect_text" },
        "selector": { "$ref": "#/$defs/selector" },
        "value": { "$ref": "#/$defs/stepValue" }
      }
    },
    "selector": { "type": "string", "minLength": 1, "maxLength": 512 },
    "stepValue": { "type": "string", "maxLength": 4096 },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_artifact_bytes",
        "max_watch_files",
        "max_watch_total_bytes",
        "lifecycle_timeout_ms",
        "max_stdout_bytes",
        "max_stderr_bytes",
        "max_processes",
        "application_memory_mb",
        "browser_memory_mb"
      ],
      "properties": {
        "max_artifact_bytes": { "type": "integer", "minimum": 1, "maximum": 67108864 },
        "max_watch_files": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "max_watch_total_bytes": { "type": "integer", "minimum": 1, "maximum": 2147483648 },
        "lifecycle_timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 600000 },
        "max_stdout_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "max_stderr_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "max_processes": { "type": "integer", "minimum": 1, "maximum": 32 },
        "application_memory_mb": { "type": "integer", "minimum": 64, "maximum": 2048 },
        "browser_memory_mb": { "type": "integer", "minimum": 128, "maximum": 2048 }
      }
    },
    "timeouts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readiness_attempt_ms",
        "readiness_total_ms",
        "readiness_interval_ms",
        "shutdown_process_ms",
        "shutdown_port_ms",
        "shutdown_reader_ms"
      ],
      "properties": {
        "readiness_attempt_ms": { "type": "integer", "minimum": 100, "maximum": 2000 },
        "readiness_total_ms": { "type": "integer", "minimum": 500, "maximum": 30000 },
        "readiness_interval_ms": { "type": "integer", "minimum": 20, "maximum": 1000 },
        "shutdown_process_ms": { "type": "integer", "minimum": 100, "maximum": 10000 },
        "shutdown_port_ms": { "type": "integer", "minimum": 100, "maximum": 10000 },
        "shutdown_reader_ms": { "type": "integer", "minimum": 100, "maximum": 10000 }
      }
    }
  }
}
