{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NoctilumeDev/VeriTrail/schemas/acceptance-plan-0.1.schema.json",
  "title": "VeriTrail AcceptancePlan 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_kind",
    "schema_version",
    "plan_id",
    "version",
    "subject",
    "question",
    "governance",
    "observation_specs",
    "evidence_requirements",
    "sufficiency_rules",
    "integrity_rules",
    "assertions",
    "resource_budget",
    "change_scope",
    "reproduction_steps",
    "cleanup_steps"
  ],
  "properties": {
    "plan_kind": { "const": "ACCEPTANCE" },
    "schema_version": { "const": "0.1" },
    "plan_id": { "$ref": "#/$defs/identifier" },
    "version": { "type": "integer", "minimum": 1 },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "source_ref"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "source_ref": { "type": "string", "minLength": 1 }
      }
    },
    "question": { "type": "string", "minLength": 1 },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_owner_ref", "drafter_ref", "seal_authority_ref", "seal_decision"],
      "properties": {
        "claim_owner_ref": { "type": "string", "minLength": 1 },
        "drafter_ref": { "type": "string", "minLength": 1 },
        "seal_authority_ref": { "type": "string", "minLength": 1 },
        "seal_decision": { "const": "CONFIRMED" }
      }
    },
    "observation_specs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/observationSpec" }
    },
    "evidence_requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidenceRequirement" }
    },
    "sufficiency_rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    },
    "integrity_rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "contains": {
        "type": "object",
        "required": ["severity"],
        "properties": {
          "severity": { "enum": ["HARD", "DEGRADATION_BOUNDARY"] }
        }
      },
      "items": { "$ref": "#/$defs/assertion" }
    },
    "resource_budget": { "$ref": "#/$defs/jsonObject" },
    "change_scope": { "$ref": "#/$defs/jsonObject" },
    "reproduction_steps": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "cleanup_steps": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "seal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "jsonValue": {
      "anyOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "integer" },
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        { "$ref": "#/$defs/jsonObject" }
      ]
    },
    "jsonObject": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/jsonValue" }
    },
    "observationSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "contract", "evidence_type", "coordinates", "projections", "canonicalization_profile"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          }
        },
        "evidence_type": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
        },
        "coordinates": { "$ref": "#/$defs/jsonObject" },
        "projections": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "canonicalization_profile": { "const": "veritrail-json-c14n/1" }
      }
    },
    "evidenceRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "observation_spec_id", "cardinality"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "observation_spec_id": { "$ref": "#/$defs/identifier" },
        "cardinality": { "const": "EXACTLY_ONE" }
      }
    },
    "operand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_id", "path"],
      "properties": {
        "requirement_id": { "$ref": "#/$defs/identifier" },
        "path": { "type": "string", "pattern": "^(?:|/(?:[^~]|~[01])*)$" }
      }
    },
    "rule": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "left", "operator", "right"],
          "properties": {
            "id": { "$ref": "#/$defs/identifier" },
            "left": { "$ref": "#/$defs/operand" },
            "operator": { "enum": ["eq", "ne", "lt", "lte", "gt", "gte", "contains", "set_equals", "contains_all"] },
            "right": {
              "anyOf": [
                { "$ref": "#/$defs/operand" },
                { "$ref": "#/$defs/jsonValue" }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "left", "operator"],
          "properties": {
            "id": { "$ref": "#/$defs/identifier" },
            "left": { "$ref": "#/$defs/operand" },
            "operator": { "const": "exists" }
          }
        }
      ]
    },
    "assertion": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "severity", "left", "operator", "right"],
          "properties": {
            "id": { "$ref": "#/$defs/identifier" },
            "severity": { "enum": ["HARD", "DEGRADATION_BOUNDARY", "OBJECTIVE", "OBSERVATION"] },
            "left": { "$ref": "#/$defs/operand" },
            "operator": { "enum": ["eq", "ne", "lt", "lte", "gt", "gte", "contains", "set_equals", "contains_all"] },
            "right": {
              "anyOf": [
                { "$ref": "#/$defs/operand" },
                { "$ref": "#/$defs/jsonValue" }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "severity", "left", "operator"],
          "properties": {
            "id": { "$ref": "#/$defs/identifier" },
            "severity": { "enum": ["HARD", "DEGRADATION_BOUNDARY", "OBJECTIVE", "OBSERVATION"] },
            "left": { "$ref": "#/$defs/operand" },
            "operator": { "const": "exists" }
          }
        }
      ]
    }
  }
}
