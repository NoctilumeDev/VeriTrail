        "admission_witness_digest"
      ],
      "properties": {
        "derivation_id": {
          "$ref": "review-r1-common-0.1.schema.json#/$defs/NonEmptyText"
        },
        "source_snapshot_digest": {
          "$ref": "review-r1-common-0.1.schema.json#/$defs/SemanticDigest"
        },
        "policy_digest": {
          "$ref": "review-r1-common-0.1.schema.json#/$defs/SemanticDigest"
        },
        "analysis_scope_digest": {
          "$ref": "review-r1-common-0.1.schema.json#/$defs/SemanticDigest"
        },
        "derivation_profile_digest": {
          "$ref": "review-r1-common-0.1.schema.json#/$defs/SemanticDigest"
        },
        "fact_set_digest": {
          "$ref": "review-r1-common-0.1.schema.json#/$defs/SemanticDigest"
        },
        "observation_domain_digest": {
          "$ref": "review-r1-common-0.1.schema.json#/$defs/SemanticDigest"
        },
        "qualification_digest": {
          "$ref": "review-r1-common-0.1.schema.json#/$defs/SemanticDigest"
        },
        "relation_provider_run_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "review-r1-common-0.1.schema.json#/$defs/SemanticDigest"
          },
          "minItems": 1
        },
        "admitted_relation_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "review-r1-common-0.1.schema.json#/$defs/SemanticDigest"
          }
        },
        "admitted_conflict_ids": {
