{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NoctilumeDev/VeriTrail/schemas/bootstrap-preview-0.2.schema.json",
  "title": "VeriTrail M11 Single-Application BootstrapPreview",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "topology",
    "plan_sha256",
    "profile_id",
    "profile_version",
    "profile_sha256",
    "subject_root_identity_sha256",
    "platform",
    "cold_state",
    "nodes",
    "start_order",
    "teardown_order",
    "application_origin",
    "browser_policy_sha256",
    "resource_policy_sha256",
    "claims",
    "preview_sha256"
  ],
  "properties": {
    "schema_version": { "const": "0.2" },
    "topology": { "const": "SINGLE_APPLICATION" },
    "plan_sha256": { "$ref": "bootstrap-preview-0.1.schema.json#/$defs/sha256" },
    "profile_id": { "$ref": "bootstrap-preview-0.1.schema.json#/$defs/identifier" },
    "profile_version": { "type": "integer", "minimum": 1 },
    "profile_sha256": { "$ref": "bootstrap-preview-0.1.schema.json#/$defs/sha256" },
    "subject_root_identity_sha256": { "$ref": "bootstrap-preview-0.1.schema.json#/$defs/sha256" },
    "platform": { "const": "WINDOWS_11" },
    "cold_state": { "const": "C1_PROCESS_COLD" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "$ref": "#/$defs/applicationNode" }
    },
    "start_order": { "$ref": "project-profile-0.2.schema.json#/$defs/oneNodeId" },
    "teardown_order": { "$ref": "project-profile-0.2.schema.json#/$defs/oneNodeId" },
    "application_origin": { "type": "string", "pattern": "^http://127\\.0\\.0\\.1:[0-9]{4,5}$" },
    "browser_policy_sha256": { "$ref": "bootstrap-preview-0.1.schema.json#/$defs/sha256" },
    "resource_policy_sha256": { "$ref": "bootstrap-preview-0.1.schema.json#/$defs/sha256" },
    "claims": { "$ref": "bootstrap-preview-0.1.schema.json#/properties/claims" },
    "preview_sha256": { "$ref": "bootstrap-preview-0.1.schema.json#/$defs/sha256" }
  },
  "$defs": {
    "applicationNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "role",
        "depends_on",
        "adapter",
        "tool_binding_id",
        "executable",
        "arguments",
        "working_directory",
        "working_directory_identity_sha256",
        "environment",
        "port",
        "port_preflight",
        "readiness",
        "limits",
        "shutdown",
        "node_policy_sha256"
      ],
      "properties": {
        "node_id": { "$ref": "bootstrap-preview-0.1.schema.json#/$defs/identifier" },
        "role": { "const": "APPLICATION" },
        "depends_on": { "const": [] },
        "adapter": { "const": "TRUSTED_PROCESS_SERVICE" },
        "tool_binding_id": { "$ref": "bootstrap-preview-0.1.schema.json#/$defs/identifier" },
        "executable": { "$ref": "bootstrap-preview-0.1.schema.json#/$defs/executable" },
        "arguments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "$ref": "bootstrap-preview-0.1.schema.json#/$defs/argument" }
        },
        "working_directory": { "$ref": "project-profile-0.1.schema.json#/$defs/relativePath" },
        "working_directory_identity_sha256": { "$ref": "bootstrap-preview-0.1.schema.json#/$defs/sha256" },
        "environment": { "$ref": "bootstrap-preview-0.1.schema.json#/$defs/environment" },
        "port": { "type": "integer", "minimum": 1024, "maximum": 65535 },
        "port_preflight": { "const": "FREE" },
        "readiness": { "$ref": "project-profile-0.1.schema.json#/$defs/readiness" },
        "limits": { "$ref": "project-profile-0.1.schema.json#/$defs/limits" },
        "shutdown": { "$ref": "project-profile-0.1.schema.json#/$defs/shutdown" },
        "node_policy_sha256": { "$ref": "bootstrap-preview-0.1.schema.json#/$defs/sha256" }
      }
    }
  }
}
