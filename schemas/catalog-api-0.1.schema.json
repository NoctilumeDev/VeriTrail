{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veritrail.local/schemas/catalog-api-0.1.schema.json",
  "title": "VeriTrail Local Read-only API 0.1",
  "oneOf": [
    { "$ref": "#/$defs/health" },
    { "$ref": "#/$defs/catalog" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "service",
        "api_version",
        "catalog_schema_version",
        "catalog_id",
        "read_only",
        "status"
      ],
      "properties": {
        "schema_version": { "const": "0.1" },
        "service": { "const": "veritrail-local-catalog" },
        "api_version": { "const": "0.1" },
        "catalog_schema_version": { "const": "0.1" },
        "catalog_id": { "type": "string", "pattern": "^cat_[0-9a-f]{24}$" },
        "read_only": { "const": true },
        "status": { "const": "READY" }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "bundleSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "file_count",
        "total_bytes",
        "duplicate_count",
        "base_url"
      ],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "file_count": { "type": "integer", "minimum": 1, "maximum": 256 },
        "total_bytes": { "type": "integer", "minimum": 0, "maximum": 67108864 },
        "duplicate_count": { "type": "integer", "minimum": 0 },
        "base_url": {
          "type": "string",
          "pattern": "^/api/v1/runs/cr_[0-9a-f]{24}/bundle/$"
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_run_id",
        "run_id",
        "created_at",
        "execution_status",
        "verdict",
        "plan",
        "bundle"
      ],
      "properties": {
        "catalog_run_id": { "type": "string", "pattern": "^cr_[0-9a-f]{24}$" },
        "run_id": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "format": "date-time" },
        "execution_status": {
          "enum": ["PLANNED", "RUNNING", "COMPLETED", "ABORTED", "ERROR"]
        },
        "verdict": { "enum": ["PASS", "FAIL", "INCONCLUSIVE", "PENDING"] },
        "plan": { "$ref": "#/$defs/plan" },
        "bundle": { "$ref": "#/$defs/bundleSummary" }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_id",
        "code",
        "candidate_id",
        "run_id",
        "bundle_digests",
        "occurrence_count"
      ],
      "properties": {
        "issue_id": { "type": "string", "pattern": "^ci_[0-9a-f]{24}$" },
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
        "candidate_id": { "type": "string", "pattern": "^cand_[0-9a-f]{20}$" },
        "run_id": { "type": ["string", "null"] },
        "bundle_digests": {
          "type": "array",
          "items": { "$ref": "#/$defs/sha256" },
          "uniqueItems": true
        },
        "occurrence_count": { "type": "integer", "minimum": 1 }
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "catalog",
        "pagination",
        "runs",
        "issues",
        "issues_truncated"
      ],
      "properties": {
        "schema_version": { "const": "0.1" },
        "catalog": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "catalog_id",
            "build_status",
            "read_only",
            "run_count",
            "issue_count",
            "duplicate_count"
          ],
          "properties": {
            "catalog_id": { "type": "string", "pattern": "^cat_[0-9a-f]{24}$" },
            "build_status": { "enum": ["COMPLETED", "COMPLETED_WITH_ISSUES"] },
            "read_only": { "const": true },
            "run_count": { "type": "integer", "minimum": 0 },
            "issue_count": { "type": "integer", "minimum": 0 },
            "duplicate_count": { "type": "integer", "minimum": 0 }
          }
        },
        "pagination": {
          "type": "object",
          "additionalProperties": false,
          "required": ["page", "page_size", "total_items", "total_pages"],
          "properties": {
            "page": { "type": "integer", "minimum": 1 },
            "page_size": { "type": "integer", "minimum": 1, "maximum": 100 },
            "total_items": { "type": "integer", "minimum": 0 },
            "total_pages": { "type": "integer", "minimum": 0 }
          }
        },
        "runs": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/run" }
        },
        "issues": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/issue" }
        },
        "issues_truncated": { "type": "boolean" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "error"],
      "properties": {
        "schema_version": { "const": "0.1" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
            "message": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
