{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NoctilumeDev/VeriTrail/schemas/command-preview-0.1.1.schema.json",
  "title": "VeriTrail CommandPreview 0.1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_sha256",
    "command_policy_sha256",
    "command_id",
    "project_profile_id",
    "adapter",
    "tool_binding_id",
    "executable",
    "arguments",
    "argument_count",
    "subject_root_identity_sha256",
    "working_directory",
    "working_directory_identity_sha256",
    "environment",
    "stdin",
    "shell_used",
    "tty_used",
    "limits",
    "write_policy",
    "subject_watch_roots",
    "subject_snapshot",
    "network_policy",
    "claims",
    "preview_sha256"
  ],
  "properties": {
    "schema_version": { "const": "0.1.1" },
    "plan_sha256": { "$ref": "command-preview-0.1.schema.json#/properties/plan_sha256" },
    "command_policy_sha256": { "$ref": "command-preview-0.1.schema.json#/properties/command_policy_sha256" },
    "command_id": { "$ref": "command-preview-0.1.schema.json#/properties/command_id" },
    "project_profile_id": { "$ref": "command-preview-0.1.schema.json#/properties/project_profile_id" },
    "adapter": { "$ref": "command-preview-0.1.schema.json#/properties/adapter" },
    "tool_binding_id": { "$ref": "command-preview-0.1.schema.json#/properties/tool_binding_id" },
    "executable": { "$ref": "command-preview-0.1.schema.json#/properties/executable" },
    "arguments": { "$ref": "command-preview-0.1.schema.json#/properties/arguments" },
    "argument_count": { "$ref": "command-preview-0.1.schema.json#/properties/argument_count" },
    "subject_root_identity_sha256": { "$ref": "command-preview-0.1.schema.json#/properties/subject_root_identity_sha256" },
    "working_directory": { "$ref": "command-preview-0.1.schema.json#/properties/working_directory" },
    "working_directory_identity_sha256": { "$ref": "command-preview-0.1.schema.json#/properties/working_directory_identity_sha256" },
    "environment": { "$ref": "command-preview-0.1.schema.json#/properties/environment" },
    "stdin": { "$ref": "command-preview-0.1.schema.json#/properties/stdin" },
    "shell_used": { "$ref": "command-preview-0.1.schema.json#/properties/shell_used" },
    "tty_used": { "$ref": "command-preview-0.1.schema.json#/properties/tty_used" },
    "limits": { "$ref": "command-preview-0.1.schema.json#/properties/limits" },
    "write_policy": { "$ref": "command-preview-0.1.schema.json#/properties/write_policy" },
    "subject_watch_roots": { "$ref": "command-preview-0.1.schema.json#/properties/subject_watch_roots" },
    "subject_snapshot": { "$ref": "#/$defs/subjectSnapshot" },
    "network_policy": { "$ref": "command-preview-0.1.schema.json#/properties/network_policy" },
    "claims": { "$ref": "command-preview-0.1.schema.json#/properties/claims" },
    "preview_sha256": { "$ref": "command-preview-0.1.schema.json#/properties/preview_sha256" }
  },
  "$defs": {
    "subjectSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_version", "watch_roots", "fingerprint", "file_count", "link_count", "total_bytes"],
      "properties": {
        "policy_version": { "const": "subject-tree-sha256/0.1" },
        "watch_roots": { "$ref": "command-preview-0.1.schema.json#/properties/subject_watch_roots" },
        "fingerprint": { "$ref": "command-preview-0.1.schema.json#/$defs/sha256" },
        "file_count": { "type": "integer", "minimum": 0 },
        "link_count": { "type": "integer", "minimum": 0 },
        "total_bytes": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
