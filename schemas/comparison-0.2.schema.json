{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veritrail.local/schemas/comparison-0.2.schema.json",
  "title": "VeriTrail Same-plan Rerun Comparison 0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "comparison_id", "comparison_type", "rule_version",
    "comparison_status", "comparable", "reasons", "sources", "differences", "limits"
  ],
  "properties": {
    "schema_version": { "const": "0.2" },
    "comparison_id": { "type": "string", "pattern": "^cmp_[0-9a-f]{24}$" },
    "comparison_type": { "const": "SAME_PLAN_RERUN" },
    "rule_version": { "const": "rerun-semantic/0.2" },
    "comparison_status": { "enum": ["MATCH", "DRIFT", "INCONCLUSIVE"] },
    "comparable": { "type": "boolean" },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "repeat"],
      "properties": {
        "baseline": { "$ref": "#/$defs/source" },
        "repeat": { "$ref": "#/$defs/source" }
      }
    },
    "differences": {
      "type": "array",
      "items": { "$ref": "comparison-0.1.schema.json#/$defs/difference" }
    },
    "limits": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sourceState": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["qualification"],
          "properties": {
            "qualification": { "enum": ["NOT_APPLICABLE", "UNAVAILABLE"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["qualification", "policy_version", "watch_roots", "fingerprint"],
          "properties": {
            "qualification": { "enum": ["APPROVED", "OBSERVED_ONLY"] },
            "policy_version": { "const": "subject-tree-sha256/0.1" },
            "watch_roots": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "fingerprint": { "$ref": "#/$defs/sha256" }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role", "run_id", "created_at", "execution_status", "verdict", "plan",
        "random_seed", "bundle_sha256", "semantic_sha256", "source_state"
      ],
      "properties": {
        "role": { "enum": ["BASELINE", "REPEAT"] },
        "run_id": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "minLength": 1 },
        "execution_status": { "enum": ["PLANNED", "RUNNING", "COMPLETED", "ABORTED", "ERROR"] },
        "verdict": { "enum": ["PASS", "FAIL", "INCONCLUSIVE", "PENDING"] },
        "plan": { "$ref": "comparison-0.1.schema.json#/$defs/plan" },
        "random_seed": { "type": "integer" },
        "bundle_sha256": { "$ref": "#/$defs/sha256" },
        "semantic_sha256": { "$ref": "#/$defs/sha256" },
        "project_profile_sha256": { "$ref": "#/$defs/sha256" },
        "source_state": { "$ref": "#/$defs/sourceState" }
      }
    }
  }
}
