{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NoctilumeDev/VeriTrail/schemas/experiment-plan.schema.json",
  "title": "VeriTrail M0 ExperimentPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "version",
    "subject",
    "question",
    "baseline",
    "experiment_type",
    "variables",
    "required_evidence",
    "assertions",
    "random_seed",
    "resource_budget",
    "load_model",
    "change_scope",
    "reproduction_steps",
    "cleanup_steps"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "plan_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$" },
    "version": { "type": "integer", "minimum": 1 },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "source_ref": { "type": "string", "minLength": 1 }
      }
    },
    "question": { "type": "string", "minLength": 1 },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "fingerprint"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["VALID", "EXPIRED"] },
        "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "tolerances": { "type": "object" }
      }
    },
    "experiment_type": { "const": "SINGLE_VARIABLE" },
    "variables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "role", "value", "source"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "role": { "enum": ["PRIMARY", "CONTROLLED", "NUISANCE"] },
          "value": {},
          "unit": { "type": "string" },
          "source": { "type": "string", "minLength": 1 }
        }
      }
    },
    "required_evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "evidence_type", "path", "operator", "expected"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "severity": {
            "enum": ["HARD", "DEGRADATION_BOUNDARY", "OBJECTIVE", "OBSERVATION"]
          },
          "evidence_type": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "pattern": "^(?:$|/)" },
          "operator": { "enum": ["eq", "ne", "lt", "lte", "gt", "gte", "contains", "exists"] },
          "expected": {}
        }
      }
    },
    "random_seed": { "type": "integer", "minimum": 0 },
    "resource_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memory_soft_mb", "memory_hard_mb", "max_artifact_bytes"],
      "properties": {
        "memory_soft_mb": { "type": "integer", "minimum": 1 },
        "memory_hard_mb": { "type": "integer", "minimum": 1 },
        "max_artifact_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "load_model": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "virtual_users": { "type": "number", "minimum": 0 },
        "in_flight_requests": { "type": "number", "minimum": 0 },
        "total_requests": { "type": "number", "minimum": 0 },
        "target_rps": { "type": "number", "minimum": 0 },
        "hotspot_contenders": { "type": "number", "minimum": 0 },
        "connections": { "type": "number", "minimum": 0 },
        "message_rate": { "type": "number", "minimum": 0 },
        "duration_seconds": { "type": "number", "minimum": 0 },
        "think_time_ms": { "type": "number", "minimum": 0 },
        "ramp_steps": { "type": "array", "minItems": 1, "items": { "type": "object" } }
      }
    },
    "change_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "owner", "expected_blast_radius", "consumers"],
      "properties": {
        "level": { "enum": ["L0_PRESENTATION", "L1_COMPONENT", "L2_CONTRACT", "L3_SYSTEM"] },
        "owner": { "type": "string", "minLength": 1 },
        "expected_blast_radius": { "type": "string", "minLength": 1 },
        "consumers": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "reproduction_steps": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "cleanup_steps": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "seal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
