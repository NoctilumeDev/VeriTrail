{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NoctilumeDev/VeriTrail/schemas/experiment-plan-0.6.schema.json",
  "title": "VeriTrail M10 ExperimentPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "version",
    "subject",
    "question",
    "baseline",
    "experiment_type",
    "variables",
    "required_evidence",
    "assertions",
    "random_seed",
    "resource_budget",
    "preflight",
    "browser",
    "bootstrap_profile",
    "load_model",
    "change_scope",
    "reproduction_steps",
    "cleanup_steps"
  ],
  "properties": {
    "schema_version": { "const": "0.6" },
    "plan_id": { "$ref": "experiment-plan-0.3.schema.json#/properties/plan_id" },
    "version": { "$ref": "experiment-plan-0.3.schema.json#/properties/version" },
    "subject": { "$ref": "experiment-plan-0.3.schema.json#/properties/subject" },
    "question": { "$ref": "experiment-plan-0.3.schema.json#/properties/question" },
    "baseline": { "$ref": "experiment-plan-0.3.schema.json#/properties/baseline" },
    "experiment_type": { "const": "SINGLE_VARIABLE" },
    "variables": {
      "allOf": [
        { "$ref": "experiment-plan-0.3.schema.json#/properties/variables" },
        {
          "contains": {
            "type": "object",
            "required": ["name", "role", "value"],
            "properties": {
              "name": { "const": "project_bootstrap_mode" },
              "role": { "const": "PRIMARY" },
              "value": { "const": "veritrail_managed_windows_c1_two_node_services" }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "required_evidence": {
      "allOf": [
        { "$ref": "experiment-plan-0.3.schema.json#/properties/required_evidence" },
        { "contains": { "const": "runtime.preflight" }, "minContains": 1, "maxContains": 1 },
        { "contains": { "const": "browser.session" }, "minContains": 1, "maxContains": 1 },
        { "contains": { "const": "runtime.bootstrap" }, "minContains": 1, "maxContains": 1 },
        {
          "not": {
            "contains": { "enum": ["runtime.command", "runtime.orchestration"] }
          }
        }
      ]
    },
    "assertions": {
      "allOf": [
        { "$ref": "experiment-plan-0.3.schema.json#/properties/assertions" },
        {
          "contains": {
            "type": "object",
            "required": ["severity", "evidence_type"],
            "properties": {
              "severity": { "enum": ["HARD", "DEGRADATION_BOUNDARY"] },
              "evidence_type": { "const": "runtime.bootstrap" }
            }
          },
          "minContains": 1
        },
        {
          "not": {
            "contains": {
              "type": "object",
              "required": ["evidence_type"],
              "properties": {
                "evidence_type": {
                  "enum": ["runtime.command", "runtime.orchestration"]
                }
              }
            }
          }
        }
      ]
    },
    "random_seed": { "$ref": "experiment-plan-0.3.schema.json#/properties/random_seed" },
    "resource_budget": { "$ref": "experiment-plan-0.3.schema.json#/properties/resource_budget" },
    "preflight": { "$ref": "experiment-plan-0.3.schema.json#/properties/preflight" },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "headless",
        "start_url",
        "allowed_origins",
        "timeout_ms",
        "viewports",
        "steps",
        "screenshot_safety",
        "max_job_memory_mb"
      ],
      "properties": {
        "engine": { "$ref": "experiment-plan-0.3.schema.json#/properties/browser/properties/engine" },
        "headless": { "$ref": "experiment-plan-0.3.schema.json#/properties/browser/properties/headless" },
        "start_url": { "$ref": "experiment-plan-0.3.schema.json#/properties/browser/properties/start_url" },
        "allowed_origins": { "$ref": "experiment-plan-0.3.schema.json#/properties/browser/properties/allowed_origins" },
        "timeout_ms": { "$ref": "experiment-plan-0.3.schema.json#/properties/browser/properties/timeout_ms" },
        "viewports": { "$ref": "experiment-plan-0.3.schema.json#/properties/browser/properties/viewports" },
        "steps": { "$ref": "experiment-plan-0.3.schema.json#/properties/browser/properties/steps" },
        "screenshot_safety": { "const": "UNREDACTED_OPERATOR_ACKNOWLEDGED" },
        "max_job_memory_mb": { "type": "integer", "minimum": 128, "maximum": 2048 }
      }
    },
    "bootstrap_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "profile_version", "profile_sha256"],
      "properties": {
        "profile_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
        },
        "profile_version": { "type": "integer", "minimum": 1 },
        "profile_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "load_model": { "$ref": "experiment-plan-0.3.schema.json#/properties/load_model" },
    "change_scope": { "$ref": "experiment-plan-0.3.schema.json#/properties/change_scope" },
    "reproduction_steps": { "$ref": "experiment-plan-0.3.schema.json#/properties/reproduction_steps" },
    "cleanup_steps": { "$ref": "experiment-plan-0.3.schema.json#/properties/cleanup_steps" },
    "seal": { "$ref": "experiment-plan-0.3.schema.json#/properties/seal" }
  }
}
