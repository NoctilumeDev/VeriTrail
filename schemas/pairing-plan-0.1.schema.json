{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veritrail.local/schemas/pairing-plan-0.1.schema.json",
  "title": "VeriTrail Four-role PairingPlan 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pairing_id",
    "version",
    "question",
    "primary_variable",
    "roles",
    "sequence",
    "warmup",
    "outcomes",
    "limits",
    "reproduction_steps",
    "cleanup_steps"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "pairing_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$" },
    "version": { "type": "integer", "minimum": 1 },
    "question": { "type": "string", "minLength": 1 },
    "primary_variable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "unit": { "type": "string", "minLength": 1 }
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["BASELINE", "TREATMENT", "RESTORED_BASELINE", "NEGATIVE_CONTROL"],
      "properties": {
        "BASELINE": { "$ref": "#/$defs/rolePlan" },
        "TREATMENT": { "$ref": "#/$defs/rolePlan" },
        "RESTORED_BASELINE": { "$ref": "#/$defs/rolePlan" },
        "NEGATIVE_CONTROL": { "$ref": "#/$defs/rolePlan" }
      }
    },
    "sequence": {
      "const": ["BASELINE", "TREATMENT", "RESTORED_BASELINE", "NEGATIVE_CONTROL"]
    },
    "warmup": {
      "const": { "mode": "NONE", "iterations": 0 }
    },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assertion_id", "expected_actual"],
        "properties": {
          "assertion_id": { "type": "string", "minLength": 1 },
          "expected_actual": {
            "type": "object",
            "additionalProperties": false,
            "required": ["BASELINE", "TREATMENT", "RESTORED_BASELINE", "NEGATIVE_CONTROL"],
            "properties": {
              "BASELINE": true,
              "TREATMENT": true,
              "RESTORED_BASELINE": true,
              "NEGATIVE_CONTROL": true
            }
          }
        }
      }
    },
    "limits": { "$ref": "#/$defs/nonEmptyStrings" },
    "reproduction_steps": { "$ref": "#/$defs/nonEmptyStrings" },
    "cleanup_steps": { "$ref": "#/$defs/nonEmptyStrings" },
    "seal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "rolePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_sha256", "primary_value"],
      "properties": {
        "plan_sha256": { "$ref": "#/$defs/sha256" },
        "primary_value": true
      }
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
