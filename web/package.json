{
  "name": "@veritrail/workbench",
  "private": true,
  "version": "0.12.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "overrides": {
    "glob": "14.0.3",
    "minimatch": "11.0.5"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run --maxWorkers=2",
    "lint": "eslint . --max-warnings=0"
  },
  "dependencies": {
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "glob": "14.0.3",
    "globals": "^17.14.0",
    "jsdom": "~29.1.1",
    "minimatch": "11.0.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.14"
  }
}
